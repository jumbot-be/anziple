# Secrets template (to be encrypted with Ansible Vault)
# Copy this file to group_vars/all_secrets.yml, fill in real values, then encrypt:
#   cp group_vars/all_secrets.yml.example group_vars/all_secrets.yml
#   ansible-vault encrypt group_vars/all_secrets.yml
keycloak_admin_password: "CHANGE_ME"
payara_admin_password: "CHANGE_ME"
postgresql_admin_password: "CHANGE_ME"
postgresql_adr_keycloak_password: "CHANGE_ME"
postgresql_adr_customer_password: "CHANGE_ME"

# RDS/External PostgreSQL credentials (when postgresql_rds_enabled: true)
postgresql_rds_hostname: "CHANGE_ME"
postgresql_rds_port: 5432
postgresql_rds_admin_user: "CHANGE_ME"
postgresql_rds_admin_password: "CHANGE_ME"

# MongoDB credentials
mongodb_admin_password: "CHANGE_ME"

# MongoDB application users (one per database, see mongodb_app_users)
mongodb_pho_password: "CHANGE_ME"
mongodb_adg_password: "CHANGE_ME"
mongodb_cms_password: "CHANGE_ME"
mongodb_hmi_password: "CHANGE_ME"
