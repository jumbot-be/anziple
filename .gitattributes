# Normaliser les fins de ligne dans le depot
* text=auto eol=lf

# Shell scripts toujours LF et executables
*.sh text eol=lf
*.py text eol=lf

# Scripts Windows en CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Ansible / YAML / Markdown toujours LF
*.yml text eol=lf
*.yaml text eol=lf
*.j2 text eol=lf
*.cfg text eol=lf
*.md text eol=lf

# Fichiers generes / donnes non normalises
*.tar.gz binary
*.zip binary
