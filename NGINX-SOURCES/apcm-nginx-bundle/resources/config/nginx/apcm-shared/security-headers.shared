#
#you should not edit this file manually it will be overwritten next upgrade
#use custom-rules.config or contact r&d
#

  ##
  # Header security
  # Based on https://owasp.org/www-project-secure-headers/ci/headers_add.json and https://cheatsheetseries.owasp.org/cheatsheets/HTTP_Headers_Cheat_Sheet.html
  ##

  #variable can be rewritten AFTER inclusion to allow custom behavior on some routes
  set $template_csp "default-src 'self'; base-uri 'self'; script-src 'self' 'nonce-$cspNonce'; connect-src 'self'; style-src 'self' 'nonce-$cspNonce'; object-src 'self';  img-src 'self' data:";

  #default for X-FRAME-OPTIONS is DENY, keycloak needs it to be SAMEORIGIN
  set $template_xframeoptions DENY;

  proxy_hide_header Strict-Transport-Security;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains";

  proxy_hide_header Referrer-Policy;
  add_header Referrer-Policy no-referrer always;

  proxy_hide_header Permissions-Policy;
  add_header Permissions-Policy "accelerometer=(), autoplay=(), camera=(), cross-origin-isolated=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), keyboard-map=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), sync-xhr=(self), usb=(), web-share=(), xr-spatial-tracking=(), clipboard-read=(), clipboard-write=(), gamepad=(), hid=(), idle-detection=(), interest-cohort=(), serial=(), unload=()" always;

  #for external identity providers you may have to tweak this one
  proxy_hide_header Access-Control-Allow-Origin;
  add_header Access-Control-Allow-Origin https://@ext.host.fqdn@ always;

  proxy_hide_header Cross-Origin-Embedder-Policy;
  add_header Cross-Origin-Embedder-Policy require-corp always;

  proxy_hide_header Cross-Origin-Opener-Policy;
  add_header Cross-Origin-Opener-Policy same-origin always;

  proxy_hide_header Cross-Origin-Resource-Policy;
  add_header Cross-Origin-Resource-Policy same-origin always;

  proxy_hide_header X-Content-Type-Options;
  add_header X-Content-Type-Options nosniff always;

  proxy_hide_header X-Frame-Options;
  add_header X-Frame-Options $template_xframeoptions always;

  proxy_hide_header X-Permitted-Cross-Domain-Policies;
  add_header X-Permitted-Cross-Domain-Policies none always;

  # For setup with multi hosts
  proxy_hide_header content-security-policy;
  add_header content-security-policy $template_csp always;

  #Should not be used https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/X-XSS-Protection replaced by csp
  proxy_hide_header x-xss-protection;
