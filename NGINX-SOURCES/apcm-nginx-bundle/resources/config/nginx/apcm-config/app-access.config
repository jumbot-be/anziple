#define ip that can access the main application and related api
#allow 10.11.0.0/16; # my client ip range




#give also access to admin users (us), this will include deny all;
include @nginx.home.directory@/@nginx.config.name@-config/admin-access.config;

#give access to uptimerobot
include @nginx.home.directory@/@nginx.config.name@-shared/uptimerobot.shared;

